# Frontend → services (Vite bakes these in at build / dev time)
# Prefix REACT_APP_ still works (see vite.config.js envPrefix).
REACT_APP_API_URL=http://localhost:8175
# Primary: Agent hybrid RAG (extractive + Clustering retrieve). Local-RAG :8176 is fallback inside Agent.
REACT_APP_CHA_URL=http://localhost:8180/api
# Leave empty to use same-origin /sim (Express serves WebGLBuilds).
# Set to http://localhost:8179 only if you run the separate WebGL static server.
REACT_APP_SIM_URL=

